# Common build configuration for all platforms.
# Templated by surfer: ${name}, ${vendor}, ${appId}, ${brandingDir},
# ${binName}, ${changeset}.

ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --disable-debug-symbols
ac_add_options --disable-tests
ac_add_options --disable-crashreporter
ac_add_options --enable-strip

# Keep a single objdir under engine/ (warden rule: one objdir only).
mk_add_options MOZ_OBJDIR=$topsrcdir/engine/objdir
